[Unit]
Description=FIT AI Telegram bot and scheduler
After=network-online.target fit-ai-backend.service
Wants=network-online.target

[Service]
Type=simple
User=fitai
Group=fitai
WorkingDirectory=/opt/fit-ai
EnvironmentFile=/opt/fit-ai/.env
ExecStart=/opt/fit-ai/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fit-ai/data

[Install]
WantedBy=multi-user.target
